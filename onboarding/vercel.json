{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/t3/:path*",
      "destination": "https://cn-api.sg.testnet.t3n.terminal3.io/:path*"
    },
    {
      "source": "/muse.md",
      "destination": "https://vault.72-60-43-195.sslip.io/muse.md"
    },
    {
      "source": "/muse-vault.json",
      "destination": "https://vault.72-60-43-195.sslip.io/muse-vault.json"
    },
    {
      "source": "/pay/:path*",
      "destination": "https://vault.72-60-43-195.sslip.io/pay/:path*"
    },
    {
      "source": "/api/pay/:path*",
      "destination": "https://vault.72-60-43-195.sslip.io/api/pay/:path*"
    },
    {
      "source": "/api/scan-link",
      "destination": "https://vault.72-60-43-195.sslip.io/api/scan-link"
    },
    {
      "source": "/api/stripe/webhook",
      "destination": "https://vault.72-60-43-195.sslip.io/api/stripe/webhook"
    }
  ],
  "headers": [
    {
      "source": "/((?!pay/|api/pay/|api/scan-link|api/stripe/|muse\\.md|muse-vault\\.json).*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self'; img-src 'self' data:; style-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/start",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/edit",
      "destination": "/?edit",
      "permanent": false
    }
  ]
}
